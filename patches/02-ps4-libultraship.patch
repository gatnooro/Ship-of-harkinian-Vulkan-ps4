+// Which of a set's two entries to fill: the one already holding this key, else an empty one, else the one the set
+// did not fill last.
+template <typename Same, typename Empty>
+inline size_t MemoFillWay(ResourceMemo& memo, size_t set, uint8_t bit, Same same, Empty empty) {
+    size_t way;
+    if (same(0)) {
+        way = 0;
+    } else if (same(1)) {
+        way = 1;
+    } else if (empty(0)) {
+        way = 0;
+    } else if (empty(1)) {
