+                                                                     mDefaultCacheArchive },
+                                                 false, nullptr)
+                           : LoadResource(
+                                 ResourceIdentifier{ std::string(name, length), mDefaultCacheOwner, mDefaultCacheArchive },
+                                 false, nullptr);
+    }
+    if (resource == nullptr) {
+        return kNoResource;
+    }
+    ResourceMemo& memo = ThreadMemo(mCacheGeneration.load(std::memory_order_acquire));
