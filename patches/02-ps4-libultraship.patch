+// The renderer and the game ask for the same resources by name or hash every frame: thousands of times a
+// frame with a texture pack. Each ask built two or three identifier strings, probed the cache two to four
+// times under its mutex, and went through a promise and a shared future (their allocations, mutex and
+// condition variable): about a fifth of the PS4's game thread in Hyrule Field. A memo per thread answers
+// repeats by the name's text or the hash, holding the resource; it starts over when the cache unloads or
+// replaces a resource (mCacheGeneration), and a resource marked dirty is a miss (reloaded as before).
+// Misses are not remembered: a resource may appear later (CacheExternalResource, a mod).
+//
+// 01.05: two entries a set, 8192 sets (it was one entry in each of 4096 slots). Hyrule Field with a texture pack
+// asks for a couple of thousand names a frame: one slot each left about a third of them sharing a slot with
+// another, both missing every frame, and a missed name takes the cache's slow path (an identifier string, the
+// mutex, the cache's own map).
+constexpr size_t kMemoSets = 8192; // a power of two
+struct ResourceMemo {
+    uint32_t generation = 0;
+    struct ByName {
+        uint64_t hash = 0;
+        std::string name;
+        std::shared_ptr<IResource> resource;
+    } names[kMemoSets * 2];
+    struct ByCrc {
+        uint64_t crc = 0;
+        std::shared_ptr<IResource> resource;
+    } crcs[kMemoSets * 2];
+    // By the address of the name: display lists ask with the same string pointer every frame, and hashing the text
+    // a byte at a time (FNV-1a: a 64-bit multiply per character, ~70 characters a path) was ~4% of the PS4's frame
+    // with a texture pack. The entry names a names[] entry; a hit still compares the text (the memory at an address
+    // can hold another path later), which costs a fraction of the hash.
+    struct ByPtr {
+        const char* ptr = nullptr;
+        uint32_t name = 0; // names[] index + 1; 0: empty
+    } ptrs[kMemoSets * 2];
+    // per set, the entry a new name (bit 0), crc (bit 1) or address (bit 2) replaces when both are taken: the one
+    // not filled last, so two that share a set both stay
+    uint8_t victim[kMemoSets] = {};
+    std::shared_ptr<IResource> scratch; // a result not kept (the cache changed during its load)
+};
