+    const uint32_t generation = mCacheGeneration.load(std::memory_order_acquire);
+    const size_t set = (size_t)((crc ^ (crc >> 29) ^ (crc >> 47)) & (kMemoSets - 1));
+    {
+        auto* ways = &ThreadMemo(generation).crcs[set * 2];
+        for (size_t w = 0; w < 2; w++) {
+            if (ways[w].crc == crc && ways[w].resource != nullptr && !ways[w].resource->IsDirty()) {
+                return ways[w].resource;
+            }
+        }
+    }
+    const std::string* hashStr = GetArchiveManager()->HashToString(crc);
+    if (hashStr == nullptr || hashStr->length() == 0) {
+        SPDLOG_TRACE("ResourceLoad: Unknown crc {}\n", crc);
+        return kNoResource;
+    }
+    std::shared_ptr<IResource> resource;
+    {
+#if defined(__PROSPERO__) || defined(__PS4__)
+        MemoLoadTimer timer;
+#endif
+        resource =
+            LoadResource(ResourceIdentifier{ *hashStr, mDefaultCacheOwner, mDefaultCacheArchive }, false, nullptr);
+    }
+    if (resource == nullptr) {
+        return kNoResource;
+    }
+    ResourceMemo& memo = ThreadMemo(mCacheGeneration.load(std::memory_order_acquire));
+    if (memo.generation != generation) {
+        memo.scratch = std::move(resource);
+        return memo.scratch;
+    }
+    auto* ways = &memo.crcs[set * 2];
+    const size_t way = MemoFillWay(
+        memo, set, 2, [&](size_t w) { return ways[w].crc == crc; },
+        [&](size_t w) { return ways[w].resource == nullptr; });
+    auto& e = ways[way];
+    e.crc = crc;
+    e.resource = std::move(resource);
+    return e.resource;
+}
