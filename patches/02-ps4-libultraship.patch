diff --git a/include/ship/utils/Ps4Stalls.h b/include/ship/utils/Ps4Stalls.h
new file mode 100644
index 0000000..fe3a503
--- /dev/null
+++ b/include/ship/utils/Ps4Stalls.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <cstdint>
+
+#if defined(__PROSPERO__) || defined(__PS4__)
+// One-off work a thread does in the middle of its frames: resources read from the archives (a mod's models and
+// textures the first time they are drawn), textures decoded and uploaded, shaders compiled and pipelines made.
+// Each thread adds up its own (the renderer's thread is the game's). Keep Game Speed (soh/OTRGlobals.cpp) leaves
+// it out of the frame and game-logic costs it picks a frame rate from, and its report names it.
+// Defined in fast/backends/gfx_vulkan.cpp.
+struct Ps4Stalls {
+    double ms = 0;          // all of it, milliseconds
+    uint32_t resources = 0; // resources loaded
+    uint32_t textures = 0;  // textures decoded and uploaded
+    uint32_t shaders = 0;   // shaders compiled and pipelines created
+};
+extern thread_local Ps4Stalls gPs4Stalls;
+#endif
